# ============================================================
# THERMASHIELD 360 - ENVIRONMENT TEMPLATE
# ============================================================

PORT=3000

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# CARTO
VITE_CARTO_API_KEY=
CARTO_API_KEY=

# Open-Meteo - no API key required
VITE_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# NOAA NCEI
NOAA_NCEI_TOKEN=

# NOAA Weather API
NOAA_USER_AGENT=ThermaShield360/1.0 (rootopsofficial@gmail.com)

# ECMWF Open Data - no API key required
ECMWF_OPEN_DATA_BASE_URL=https://data.ecmwf.int/forecasts

# Copernicus CDS / ERA5
COPERNICUS_CDS_URL=https://cds.climate.copernicus.eu/api
COPERNICUS_CDS_API_KEY=

# OpenAQ
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3

# NASA FIRMS
NASA_FIRMS_MAP_KEY=
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api

# NASA POWER - no API key required
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api

# India Data.gov.in
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_BASE_URL=https://api.data.gov.in/resource

# Data engine
DATA_MODE=live

# Refresh
WEATHER_REFRESH_INTERVAL_MS=300000
AIR_QUALITY_REFRESH_INTERVAL_MS=600000
FORECAST_REFRESH_INTERVAL_MS=1800000
HISTORICAL_CACHE_TTL_MS=86400000

# Data transparency
REQUIRE_DATA_SOURCE_METADATA=true
SHOW_DATA_SOURCE_STATUS=true
ENABLE_DEMO_FALLBACK=true