# ============================================================
# THERMASHIELD 360 — PRODUCTION & DEVELOPMENT ENVIRONMENT TEMPLATE
# ============================================================
# Copy this file to .env (for local dev) or enter variables in your
# cloud hosting dashboard (e.g. Render, Railway, Vercel).
# NEVER commit actual secret keys or credentials to git.
# ============================================================

# ------------------------------------------------------------
# 1. RUNTIME & SERVER CONFIGURATION
# ------------------------------------------------------------
# PORT: Injected automatically by cloud hosts (e.g. Render, Railway, Heroku).
# Default: 3000
PORT=3000

# NODE_ENV: Set to 'production' on deployed instances
NODE_ENV=production

# ------------------------------------------------------------
# 2. CORS & DOMAIN ARCHITECTURE (Backend Server Secrets/Config)
# ------------------------------------------------------------
# Comma-separated list of allowed origins.
# For single-service deployments (frontend + backend on same domain),
# leave empty or set to your public domain URL.
# Example: https://thermashield-360.onrender.com
ALLOWED_ORIGINS=
FRONTEND_URL=

# ------------------------------------------------------------
# 3. FRONTEND API ROUTING (Browser Safe - Optional)
# ------------------------------------------------------------
# For same-origin deployment (recommended), leave empty.
# If deploying frontend and backend to separate hosts (e.g. Vercel + Render),
# set this to the backend base URL (e.g. https://thermashield-api.onrender.com).
VITE_API_BASE_URL=

# ------------------------------------------------------------
# 4. SUPABASE CLOUD AUTHENTICATION & POSTGRESQL DATABASE
# ------------------------------------------------------------
# [PUBLIC SAFE] Client-side connection parameters (used in browser client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# [SERVER SECRET] Backend service-role key (used only by Express server - NEVER expose to browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------
# 5. GOOGLE MAPS & GIS INFRASTRUCTURE
# ------------------------------------------------------------
# [PUBLIC SAFE] Browser Maps JavaScript API key (restrict by HTTP Referrer in Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key

# [SERVER SECRET] Backend Google API key (used for server-side geocoding & routes)
GOOGLE_MAPS_API_KEY=your-google-maps-server-key

# CARTO Basemaps
VITE_CARTO_API_KEY=
CARTO_API_KEY=

# ------------------------------------------------------------
# 6. EXTERNAL REAL DATA PROVIDERS
# ------------------------------------------------------------
# Open-Meteo NWP & Biometeorology — Free / Open access (No API key needed)
VITE_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ECMWF Open Data — Free / Open medium-range NWP (No API key needed)
ECMWF_OPEN_DATA_BASE_URL=https://data.ecmwf.int/forecasts

# NASA POWER — Free / Open met & solar radiation (No API key needed)
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api

# [SERVER SECRET] Copernicus Climate Data Store (CDS / ERA5 Reanalysis)
COPERNICUS_CDS_URL=https://cds.climate.copernicus.eu/api
COPERNICUS_CDS_API_KEY=your-copernicus-cds-api-key

# [SERVER SECRET] NASA FIRMS (VIIRS 375m Satellite Thermal Anomaly)
NASA_FIRMS_MAP_KEY=your-nasa-firms-map-key
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api

# [SERVER SECRET] OpenAQ v3 (In-situ Air Quality Network)
OPENAQ_API_KEY=your-openaq-api-key
OPENAQ_BASE_URL=https://api.openaq.org/v3

# [SERVER SECRET] NOAA NCEI CDO (Historical GHCN-Daily Climate Data)
NOAA_NCEI_TOKEN=your-noaa-ncei-cdo-token
NOAA_USER_AGENT=ThermaShield360/1.0 (contact@thermashield.org)

# [SERVER SECRET] India Data.gov.in (Optional)
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_BASE_URL=https://api.data.gov.in/resource

# ------------------------------------------------------------
# 7. THERMAL ENGINE & VALIDATION POLICIES
# ------------------------------------------------------------
# DATA_MODE: 'live' enforces strict real data & quarantines synthetic/demo models
DATA_MODE=live

# Refresh cadence (milliseconds)
WEATHER_REFRESH_INTERVAL_MS=300000
AIR_QUALITY_REFRESH_INTERVAL_MS=600000
FORECAST_REFRESH_INTERVAL_MS=1800000
HISTORICAL_CACHE_TTL_MS=86400000

# Provenance transparency
REQUIRE_DATA_SOURCE_METADATA=true
SHOW_DATA_SOURCE_STATUS=true
ENABLE_DEMO_FALLBACK=true